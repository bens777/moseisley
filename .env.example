# ============================================================
# Moseisley.sh environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

# --- Core ---
ENVIRONMENT=development                 # development | production | test
# PostgreSQL is canonical in production. SQLite works for quick local runs.
# NOTE: internal identifiers (db user/name, file names) intentionally keep the historical
# 'mychief' value — renaming them would break existing deployments for zero user benefit.
DATABASE_URL=postgresql+asyncpg://mychief:mychief@localhost:5432/mychief
# DATABASE_URL=sqlite+aiosqlite:///./mychief.db

# Secret for signing tokens. Use a long random value in production.
APP_SECRET=change-me-to-a-long-random-string

# 32-byte key for AES-256-GCM secret encryption (base64 or hex).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# --- Authentication (self-hosted; PostgreSQL-backed) ---
SESSION_LIFETIME_SECONDS=2592000        # 30 days
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Email delivery (EmailProvider abstraction) ---
EMAIL_PROVIDER=console                  # console | smtp | memory
EMAIL_FROM="Moseisley.sh <no-reply@yourdomain.example>"
SMTP_HOST=localhost                     # e.g. Mailpit in dev, any SMTP in prod
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Storage (StorageAdapter abstraction) ---
STORAGE_BACKEND=local                   # local | s3 (S3-compatible protocol, not AWS-specific)
STORAGE_LOCAL_PATH=./data/storage
S3_ENDPOINT_URL=                        # e.g. https://minio.internal:9000 (empty = AWS)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Telegram (external requirement: create a bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                # random string; sent by Telegram on each webhook call
TELEGRAM_MODE=webhook                   # webhook | polling | disabled  (polling = no public URL needed)

# --- Google OAuth (external requirement: OAuth client in Google Cloud Console) ---
# Enable Gmail API + Calendar API, create OAuth client (web), add redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# --- Payments (simulator is the default; no real money) ---
PAYMENT_PROVIDER=simulated              # simulated | stripe_test
STRIPE_API_KEY=                         # test key only until eligibility verified
REAL_PAYMENTS_ENABLED=false             # hard feature flag

# --- Stripe Billing (hosted subscriptions; optional — Community works without) ---
# Final pricing: Basic $9/month, Pro $19/month (BYOK — LLM usage is billed by the
# user's own AI providers and is never included in a Moseisley subscription).
STRIPE_PRICE_ID_BASIC=                  # price_... for Basic ($9/mo)
STRIPE_PRICE_ID_PRO=                    # price_... for Pro ($19/mo)
STRIPE_PRICE_ID=                        # legacy single-price config; treated as Pro
STRIPE_WEBHOOK_SECRET=                  # whsec_... ; webhook endpoint: /api/billing/webhook
# Where Stripe sends the user back after the Customer Portal (cancel / change
# plan / update card). Unset = FRONTEND_ORIGIN + /settings. The portal itself
# must be enabled in the Stripe dashboard: Settings → Billing → Customer portal.
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings

# --- The Bar (one-time fuel purchases; optional) ---
# Three ONE-TIME Stripe Prices (mode=payment, not subscriptions). Create them in
# the Stripe dashboard as one-off prices on a product each, then paste the ids.
# Any of them unset → the Bar page shows "the bar is closed" and nothing breaks.
STRIPE_PRICE_ID_ALE=                    # Nebula Ale — $2 → +50 factory requests
STRIPE_PRICE_ID_PUNCH=                  # Purple Tentacle Punch — $5 → +150 requests
STRIPE_PRICE_ID_ROUND=                  # Buy a Round — $5 → gift +100 requests to a friend

# --- Factory mode (platform-provided AI; optional) ---
# ONE OpenRouter key funds all factory traffic (14-day trial + paid plans).
# Load it with PREPAID credits: the balance is the absolute spend ceiling —
# top up when OpenRouter emails a low-balance notice. Never stored in the DB,
# never returned by any API. Leave unset (self-host default) = factory mode
# unavailable, BYOK-only, and everything behaves as before.
FACTORY_OPENROUTER_API_KEY=
FACTORY_TRIAL_DAYS=14
FACTORY_TRIAL_DAILY_REQUESTS=40         # per-user daily cap during the trial
FACTORY_BASIC_DAILY_REQUESTS=150        # per-user daily cap on Basic ($9)
FACTORY_PRO_DAILY_REQUESTS=400          # per-user daily cap on Pro ($19) — the bigger tank
# FACTORY_PAID_DAILY_REQUESTS=300       # DEPRECATED single paid cap; if set it still
                                        # applies to BOTH plans above and logs a warning

# --- Worker ---
WORKER_POLL_SECONDS=5

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
